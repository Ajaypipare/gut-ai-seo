  </g>
  <g fill="#0f1724"><rect x="240" y="70" width="200" height="60" rx="8"/><text x="260" y="95" fill="#fff" font-size="12">Input (Google Sheets/CSV)</text></g>
  <g fill="#0f1724"><rect x="470" y="70" width="220" height="60" rx="8"/><text x="490" y="95" fill="#fff" font-size="12">Prompt Builder (function)</text></g>
